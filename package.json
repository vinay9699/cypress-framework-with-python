{
  "name": "cypress-framework",
  "version": "1.0.0",
  "description": "Cypress E2E Automation Framework using Page Object Model",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:headed": "cypress run --headed",

    "cy:run:dev": "CYPRESS_ENV=dev cypress run",
    "cy:run:staging": "CYPRESS_ENV=staging cypress run",
    "cy:run:prod": "CYPRESS_ENV=prod cypress run",

    "cy:smoke": "cypress run --env grep=@smoke",
    "cy:regression": "cypress run --env grep=@regression",
    "cy:sanity": "cypress run --env grep=@sanity",
    "cy:api": "cypress run --env grep=@api",
    "cy:login": "cypress run --env grep=@login",

    "test:login": "cypress run --spec 'cypress/e2e/login/login.cy.js'",
    "test:api": "cypress run --spec 'cypress/e2e/api/api-intercept.cy.js'",
    "test:excel": "cypress run --spec 'cypress/e2e/login/login-excel.cy.js'",

    "report:mochawesome": "mochawesome-merge cypress/reports/mochawesome/*.json -o cypress/reports/mochawesome/merged.json && marge cypress/reports/mochawesome/merged.json --reportDir cypress/reports/mochawesome/html --inline",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:clean": "rm -rf cypress/reports allure-results allure-report cypress/videos",

    "test:login:report": "npm run test:login && npm run report:mochawesome",
    "test:smoke:report": "npm run cy:smoke && npm run report:mochawesome"
  },
  "keywords": [
    "cypress",
    "automation",
    "e2e",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cypress/grep": "^6.0.0",
    "allure-cypress": "^3.8.0",
    "cypress": "^15.15.0",
    "cypress-multi-reporters": "^2.0.5",
    "eslint": "^10.4.0",
    "eslint-plugin-cypress": "^6.4.1",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "xlsx": "^0.18.5"
  }
}
