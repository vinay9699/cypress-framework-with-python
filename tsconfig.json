{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["cypress"],
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true
  },
  "include": [
    "cypress/**/*.js",
    "cypress/**/*.ts",
    "cypress/**/*.d.ts"
  ]
}
